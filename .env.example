MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/englishmate?retryWrites=true&w=majority
AUTH_SECRET=your-random-32-byte-base64-secret
AUTH_URL=http://localhost:3000
# Set AUTH_TRUST_HOST=true only behind a trusted reverse proxy.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_NAME=Admin

# Civil dates for notebook grouping, calendar and daily statistics.
APP_TIMEZONE=Asia/Tashkent

# AI Provider Selection: 'gemini' | 'openai' | 'mock'
AI_PROVIDER=mock

# Google Gemini Configuration (Server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Configuration (Server-side only)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini