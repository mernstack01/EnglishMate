MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/englishmate?retryWrites=true&w=majority
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3000
# Set AUTH_TRUST_HOST=true only behind a trusted reverse proxy.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
ADMIN_NAME=Admin

# Civil dates for notebook grouping, calendar and daily statistics.
APP_TIMEZONE=Asia/Tashkent

# AI Provider Selection: 'gemini' | 'openai' | 'mock'
AI_PROVIDER=mock

# Google Gemini Configuration (Server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Configuration (Server-side only)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini